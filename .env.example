# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, NEVER expose to the browser.
# Used by the TCGdex sync script to write to the cards table (which regular
# users can only read, per the RLS policies in supabase/schema.sql).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed for scripts/backfill-images-from-archive.ts — the full local
# path to a folder of card image scans (organized one subfolder per set;
# nesting depth doesn't matter, see that script's header comment). Not used
# by the app itself or by any other script.
LOCAL_CARD_ARCHIVE_PATH=

# Only needed for scripts/backfill-images-manual.ts — a folder of hand-picked
# card images named "<SET_PREFIX>_<CARD_NUMBER>_....<ext>" (see that script's
# header comment). Point this at wherever you drop those files, e.g.
# "manual-card-images" relative to the project root.
MANUAL_CARD_IMAGES_PATH=manual-card-images

# Used by src/lib/notify.ts to email Ross whenever someone submits a
# feature request on the /feedback page (see that file's header comment).
# Get a free API key at resend.com — no custom domain needed, since the
# notification is just sent to the same address the Resend account itself
# was signed up with. Leave unset to skip email notifications entirely
# (feature requests still save fine either way, just silently).
RESEND_API_KEY=
